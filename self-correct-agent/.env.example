# Local llama.cpp model
QWEN_GGUF_PATH=/absolute/path/to/model.gguf
LOCAL_LLM_HOST=127.0.0.1
LOCAL_LLM_PORT=8080
LOCAL_LLM_MODEL=qwen3-8b
LOCAL_LLM_TIMEOUT_SECONDS=600

# Optional OpenAI-compatible provider
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional Anthropic-compatible provider
ANTHROPIC_BASE_URL=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_MODEL=
ANTHROPIC_THINKING=disabled
